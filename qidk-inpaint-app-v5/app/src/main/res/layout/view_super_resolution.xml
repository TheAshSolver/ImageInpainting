<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/srRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/qidk_canvas"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ Super-Resolution"
            android:textColor="@color/qidk_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Null-space detail transfer • every pass is quality-gated"
            android:textColor="@color/qidk_purple"
            android:textSize="12sp" />

        <!-- Execution target -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="⚙️ Execution Target"
                android:textColor="@color/qidk_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/srEngineSpinner"
                style="@style/Widget.QIDK.Spinner"
                android:layout_width="match_parent"
                android:layout_height="48dp" />

            <TextView
                android:id="@+id/srEngineNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/qidk_amber"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Scale"
                android:textColor="@color/qidk_text_muted"
                android:textSize="11sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/srScaleChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/srChip2x"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:checked="true"
                    android:text="2×  1024" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/srChip4x"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="4×  2048" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/srChip8x"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="8×  4096" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Backend"
                android:textColor="@color/qidk_text_muted"
                android:textSize="11sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/srBackendChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/srChipNpu"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:checked="true"
                    android:text="NPU" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/srChipGpu"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="GPU" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/srChipCpu"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="CPU" />
            </com.google.android.material.chip.ChipGroup>

            <LinearLayout
                android:id="@+id/srDetailRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Detail strength"
                        android:textColor="@color/qidk_text_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/srDetailValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="60 %"
                        android:textColor="@color/qidk_cyan"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/srDetailSlider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0"
                    android:valueTo="100"
                    android:stepSize="5"
                    android:value="60" />
            </LinearLayout>

            <TextView
                android:id="@+id/srScaleInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textColor="@color/qidk_text_muted"
                android:textSize="11sp" />

            <Button
                android:id="@+id/srBtnUpscale"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="@color/qidk_crimson"
                android:text="⚡ Upscale"
                android:textColor="@color/qidk_on_accent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/srBtnCancel"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:textAllCaps="false"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/srProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="1000"
                android:visibility="gone" />

            <TextView
                android:id="@+id/srStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/qidk_text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Two stacked viewports on one shared pan / zoom state -->
        <qidk.fix.DualViewport
            android:id="@+id/srDual"
            android:layout_width="match_parent"
            android:layout_height="640dp"
            android:layout_marginBottom="12dp" />

        <!-- Post-run card -->
        <LinearLayout
            android:id="@+id/srTelemetryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_telemetry"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 Run telemetry"
                android:textColor="@color/qidk_info_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/srTelemetryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:textColor="@color/qidk_telemetry_text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/srNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:textColor="@color/qidk_telemetry_text"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
