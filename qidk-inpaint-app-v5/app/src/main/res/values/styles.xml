<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.QIDK.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:popupBackground">@drawable/bg_popup</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">4dp</item>
    </style>

    <style name="Widget.QIDK.EditText" parent="">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:textColor">@color/qidk_text</item>
        <item name="android:textColorHint">@color/qidk_text_muted</item>
        <item name="android:padding">12dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.QIDK.Mono" parent="">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
